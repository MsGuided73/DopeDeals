# Supabase MCP Server Configuration
# Get your API key for free at https://thequery.dev

# Required: Get your API key from https://thequery.dev
QUERY_API_KEY=your-api-key-here

# Required: Your Supabase project reference (found in your project URL)
SUPABASE_PROJECT_REF=your-project-ref-here

# Required: Your database password
SUPABASE_DB_PASSWORD=your-db-password-here

# Optional: AWS region where your Supabase project is hosted (defaults to us-east-1)
SUPABASE_REGION=us-east-1

# Optional: Personal access token for Supabase Management API
SUPABASE_ACCESS_TOKEN=your-access-token-here

# Optional: Service role key for Auth Admin SDK
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
