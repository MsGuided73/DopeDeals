# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Database Configuration for Prisma (Session Mode - Port 5432)
DATABASE_URL="postgresql://postgres.yourproject:password@db.yourproject.supabase.co:5432/postgres"

# Site URL (used by sitemap/robots)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Zoho Integration
# Data Center options: us, eu, in
ZOHO_DC=us
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token
ZOHO_ORGANIZATION_ID=your_zoho_org_id
ZOHO_REDIRECT_URI=http://localhost:3000/api/zoho/oauth/callback

# KajaPay Payment Gateway — values read by lib/services/kajapay/client.ts
# All five below are required for /api/checkout to successfully create a payment
# session. KAJAPAY_PAYMENT_PAGE_SLUG is the most common omission and throws
# "KAJAPAY_PAYMENT_PAGE_SLUG is not configured" before the API call.
KAJAPAY_ENVIRONMENT=sandbox
KAJAPAY_SOURCE_KEY=your_kajapay_source_key
KAJAPAY_SOURCE_KEY_PIN=your_kajapay_source_key_pin
KAJAPAY_PASSWORD=your_kajapay_password
KAJAPAY_PAYMENT_PAGE_SLUG=your_payment_page_slug
KAJAPAY_TOKENIZATION_KEY=your_kajapay_tokenization_key

# OpenAI for AI Features
OPENAI_API_KEY=your_openai_api_key

# ShipStation Integration
SHIPSTATION_API_KEY=your_shipstation_api_key
SHIPSTATION_API_SECRET=your_shipstation_api_secret

# Planning seed additions for migration tasks
SUPABASE_ANON_KEY=
ZOHO_BASE_URL=
SHIPSTATION_BASE_URL=https://ssapi.shipstation.com


# Optional toggles
PRISMA_ENABLED=false
SHIPSTATION_WEBHOOK_URL=
SHIPSTATION_DEFAULT_WAREHOUSE_ID=
SHIPSTATION_SYNC_INTERVAL=3600000
SHIPSTATION_ENABLE_WEBHOOKS=false
# BMB Wholesale warehouse origin ZIP (Salem, NH). Required by ShipStation rate-shopping.
SHIPSTATION_FROM_POSTAL_CODE=03079
SHIPSTATION_WEBHOOK_SECRET=

# Compliance pipeline
LEGISCAN_API_KEY=
LEGISCAN_BASE_URL=https://api.legiscan.com/
