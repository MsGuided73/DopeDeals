# DopeDeals Environment Configuration
# Copy this file to .env.local and update with your actual values

# =====================================================
# N8N WEBHOOK CONFIGURATION
# =====================================================

# CSV Upload Webhook - n8n workflow for processing CSV files
# Format: https://your-n8n-instance.com/webhook/your-webhook-id
N8N_CSV_WEBHOOK=https://your-n8n-instance.com/webhook/csv-product-import

# =====================================================
# SUPABASE CONFIGURATION
# =====================================================

# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url

# Supabase Anon Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# =====================================================
# ADMIN CONFIGURATION
# =====================================================

# Admin Dashboard Settings
NEXT_PUBLIC_ADMIN_EMAIL=admin@yourdomain.com

# =====================================================
# OPTIONAL: ADDITIONAL WEBHOOKS
# =====================================================

# Product Update Webhook (if needed)
# N8N_PRODUCT_WEBHOOK=https://your-n8n-instance.com/webhook/product-update

# Inventory Sync Webhook (if needed)
# N8N_INVENTORY_WEBHOOK=https://your-n8n-instance.com/webhook/inventory-sync
